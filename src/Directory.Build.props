<Project>
  <!-- Shared by the BlazeImGui and BlazeImGui.Overlay packages: `tools\pack.ps1` builds both at this version.
       Bump Version for every release (NuGet caches packages by version). -->
  <PropertyGroup>
    <Version>1.2.4</Version>
    <Authors>zack polc</Authors>
    <PackageTags>imgui;overlay;ui;theme</PackageTags>
    <RepositoryUrl>https://github.com/blaze280599/BlazeImGui</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
</Project>
