<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>BlazeImGui</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <PropertyGroup>
    <!-- The menu, widgets, theme and fonts for any ImGui.NET host; BlazeImGui.Overlay adds the standalone window. -->
    <PackageId>BlazeImGui</PackageId>
    <Description>Themed, animated Dear ImGui menu for ImGui.NET: a four-column menu, light and dark themes, Inter and Lucide icon fonts embedded, toasts and widgets. Works in any host that owns an ImGui context; BlazeImGui.Overlay adds a ready-made transparent overlay window.</Description>
  </PropertyGroup>
  <ItemGroup>
    <!-- Exact version ([x]): consumers get it and NuGet errors on a mismatch instead of breaking at runtime. -->
    <PackageReference Include="ImGui.NET" Version="[1.91.6.1]" />
  </ItemGroup>
  <ItemGroup>
    <!-- Fonts ship inside the DLL, so consumers copy nothing. -->
    <EmbeddedResource Include="Assets\Fonts\*.ttf" LogicalName="BlazeImGui.Fonts.%(Filename)%(Extension)" />
    <None Include="Assets\Fonts\*-LICENSE.txt" Pack="true" PackagePath="licenses\" />
    <None Include="PACKAGE.md" Pack="true" PackagePath="README.md" />
  </ItemGroup>
</Project>
